{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trust-no-one-agents",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "durable_objects": {
    "bindings": [
      { "name": "ORACLE", "class_name": "OracleAgent" },
      { "name": "SHADOW", "class_name": "ShadowAgent" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OracleAgent", "ShadowAgent"] }],
  "vars": {
    "MODEL": "gemma-4-26b-a4b-it",
    "EVIDENCE_IMAGE_URL": "https://raw.githubusercontent.com/Purtee13/Trust-No-One/main/public/evidence/pod-b-camera.png"
  }
}
